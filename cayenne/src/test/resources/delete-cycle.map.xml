		<dbAttribute name="B_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<dbEntity name="DEL_CYCLE_E">
		<dbAttribute name="F_REF" type="INTEGER"/>
		<dbAttribute name="ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="PARENT_ID" type="INTEGER"/>
	</dbEntity>
	<dbEntity name="DEL_CYCLE_E_EXT">
		<dbAttribute name="ID" type="INTEGER" primaryKey="true" mandatory="true"/>
