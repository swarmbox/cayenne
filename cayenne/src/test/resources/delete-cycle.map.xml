	<objEntity name="DelCycleE" className="org.apache.cayenne.GenericPersistentObject" dbEntityName="DEL_CYCLE_E">
		<objAttribute name="note" type="java.lang.String" dbAttributePath="ext.NOTE"/>
	</objEntity>
	<objEntity name="DelCycleF" className="org.apache.cayenne.GenericPersistentObject" dbEntityName="DEL_CYCLE_F"/>
	<objEntity name="DelCycleRoot" className="org.apache.cayenne.GenericPersistentObject" dbEntityName="DEL_CYCLE_A">
		<objAttribute name="disc" type="java.lang.String" dbAttributePath="DISC"/>
	</objEntity>
	<objEntity name="DelCycleSub" superEntityName="DelCycleRoot" className="org.apache.cayenne.GenericPersistentObject">
		<qualifier><![CDATA[disc = "S"]]></qualifier>
		<objAttribute name="extra" type="java.lang.String" dbAttributePath="sub.EXTRA"/>
	</objEntity>
	<dbRelationship name="b" source="DEL_CYCLE_A" target="DEL_CYCLE_B">
		<dbAttributePair source="B_REF" target="B_ID"/>
	</dbRelationship>
	<dbRelationship name="bs" source="DEL_CYCLE_A" target="DEL_CYCLE_B" toMany="true">
