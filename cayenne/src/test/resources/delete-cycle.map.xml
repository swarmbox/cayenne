	<objRelationship name="as" source="DelCycleB" target="DelCycleRoot" dbRelationshipPath="as"/>
	<objRelationship name="children" source="DelCycleE" target="DelCycleE" dbRelationshipPath="children"/>
	<objRelationship name="es" source="DelCycleF" target="DelCycleE" dbRelationshipPath="es"/>
	<objRelationship name="f" source="DelCycleE" target="DelCycleF" dbRelationshipPath="f"/>
	<objRelationship name="parent" source="DelCycleE" target="DelCycleE" dbRelationshipPath="parent"/>
	<objRelationship name="b" source="DelCycleRoot" target="DelCycleB" dbRelationshipPath="b"/>
	<objRelationship name="children" source="DelCycleRoot" target="DelCycleRoot" dbRelationshipPath="children"/>
	<objRelationship name="parent" source="DelCycleRoot" target="DelCycleRoot" dbRelationshipPath="parent"/>
</dataMap>
