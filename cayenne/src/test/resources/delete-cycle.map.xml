		<dbAttributePair source="PARENT_ID" target="ID"/>
	</dbRelationship>
	<dbRelationship name="sub" source="DEL_CYCLE_A" target="DEL_CYCLE_A_SUB" toDependentPK="true">
		<dbAttributePair source="ID" target="ID"/>
	</dbRelationship>
	<dbRelationship name="master" source="DEL_CYCLE_A_SUB" target="DEL_CYCLE_A">
		<dbAttributePair source="ID" target="ID"/>
	</dbRelationship>
	<dbRelationship name="a" source="DEL_CYCLE_B" target="DEL_CYCLE_A">
